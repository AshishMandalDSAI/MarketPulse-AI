# MarketPulse AI - Environment Variables Template
#
# SETUP:  cp .env.example .env   then fill in real values below.
# .env is gitignored and dockerignored — never commit it.
# docker-compose reads from .env (not this file).

# Currently UNUSED. The AI Marketing Analyst is rule-based and runs offline;
# no code path calls an LLM whether or not this is set. Kept for future use.
ANTHROPIC_API_KEY=

# Optional: override the SQLite database path (defaults to data/processed/marketpulse.db)
DATABASE_PATH=data/processed/marketpulse.db

# Optional: FastAPI server host/port (used by uvicorn if you customize the run command)
API_HOST=127.0.0.1
API_PORT=8000

# Optional: Streamlit server port
STREAMLIT_PORT=8501

# Security mode for the FastAPI backend: development (default) or production.
#   development — MARKETPULSE_API_KEY is optional; without it the API logs a
#                 warning listing the protected endpoints that are left open.
#   production  — MARKETPULSE_API_KEY is REQUIRED; the API refuses to start
#                 without it. Use this for any shared or internet-facing deployment.
MARKETPULSE_ENV=development

# API key for protected endpoints (sent by clients as the X-API-Key header).
# Protected: POST /upload, /datasets/{id}/confirm, /optimize-budget,
#            /simulate-budget, /ask, /datasets/{id}/decisions/run;
#            GET /datasets/{id}/decisions and GET /kpis?dataset_id=<uploaded id>.
# Public:    /, /health, /docs, /openapi.json, /channels, /model-performance,
#            /attribution, and /kpis for the built-in demo dataset.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# (API_KEY is accepted as a legacy alias.)
MARKETPULSE_API_KEY=

# Optional: Comma-separated list of allowed CORS origins for the API.
# In production, set this to your actual frontend domain(s).
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# If unset, defaults to localhost development origins (8501, 3000, 8000).
# WARNING: Never use "*" in production.
CORS_ORIGINS=

# --- Dashboard sign-in ---------------------------------------------------------
# PBKDF2 hash of the team password (never the password itself). Generate with:
#   python -m dashboard.components.auth
# Required when MARKETPULSE_ENV=production (the dashboard refuses to serve without it).
# IMPORTANT: docker compose interpolates '$' in .env — write every '$' in the hash as '$$'.
MARKETPULSE_DASHBOARD_PASSWORD_HASH=

# --- API rate limiting (requests per minute, per client IP) --------------------
# Default: on in production, off in development. Set on/off to override.
MARKETPULSE_RATE_LIMIT=
MARKETPULSE_RATE_LIMIT_UPLOAD=10
MARKETPULSE_RATE_LIMIT_COMPUTE=30
MARKETPULSE_RATE_LIMIT_DEFAULT=120

# The API must run with exactly one worker (in-memory upload registry + rate
# limiter). Production refuses WEB_CONCURRENCY > 1.

# Docker only: set to true to build the dashboard image with the optional XGBoost, LightGBM
# and CatBoost models (requirements-optional.txt + libgomp1). Default false.
INSTALL_OPTIONAL_ML=false
